{
  "env": {
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1"
  },
  "hooks": {
    "SubagentStart": [
      { "hooks": [ { "type": "command", "command": "python3 scripts/log_subagent.py start" } ] }
    ],
    "SubagentStop": [
      { "hooks": [ { "type": "command", "command": "python3 scripts/log_subagent.py stop" } ] }
    ]
  }
}
